        {
          "info": {
            "name": "Fetches buyer company information",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.kriya.dev/onboarding/buyers/single",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Fetches detailed information about a buyer company using its identifier."
        },
        {
          "info": {
            "name": "Modifies buyer's contact information",
            "type": "http"
          },
          "http": {
